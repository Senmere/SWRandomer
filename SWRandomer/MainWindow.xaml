<Window x:Class="SWRandomer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SWRandomer"
        mc:Ignorable="d"
        Title="SWRandomer" Height="300" Width="360">
    <Grid Background="#FFF4F4F4">
        <Label x:Name="RandomNum" Content="Num" HorizontalAlignment="Center" VerticalAlignment="Top" Height="140" Width="300" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Normal" FontSize="72" Margin="0,10,0,0"/>
        <Button x:Name="Button1" Content="开始抽号" HorizontalAlignment="Left" Margin="25,160,0,0" VerticalAlignment="Top" Height="30" Width="128" Click="Button1_Click"/>
        <Button x:Name="Button2" Content="设置" HorizontalAlignment="Left" Margin="25,195,0,0" VerticalAlignment="Top" Height="30" Width="59" Click="Button2_Click"/>
        <Border BorderBrush="#FFE9E9E9" BorderThickness="1" HorizontalAlignment="Center" Height="140" VerticalAlignment="Top" Width="300" Margin="0,10,0,0"/>
        <Button x:Name="Button3" Content="设置" HorizontalAlignment="Left" Margin="94,195,0,0" VerticalAlignment="Top" Height="30" Width="59" Click="Button2_Click"/>
    </Grid>
</Window>
